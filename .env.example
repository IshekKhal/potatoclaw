# ==============================================================================
# PotatoClaw — Environment Variables Template
# Copy this file to .env and fill in your keys. Never commit .env to git.
# ==============================================================================

# 1. Google AI Studio (Gemma 4 12B IT reasoning & vision)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Prior Labs (TabPFN 3.5 tabular anomaly engine)
# Get free key at: https://platform.priorlabs.ai/account/api-keys
TABPFN_API_KEY=

# 3. Sentry (Error & Distributed Tracing)
# Get DSN at: https://sentry.io -> Create Project -> FastAPI -> Copy DSN
SENTRY_DSN=

# 4. Groq Cloud (Whisper Large V3 Turbo STT - ~80ms speech-to-text)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=

# 5. ElevenLabs (Spoken briefs - Free tier gives 10k chars/mo, no card required)
# Get free key at: https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# 6. Backboard.io (Persistent assistant memory - $5 credit active)
# Get key at: https://app.backboard.io/dashboard/api-keys
BACKBOARD_API_KEY=

# 7. Server Configuration
HOST=0.0.0.0

PORT=8000
ENVIRONMENT=development

