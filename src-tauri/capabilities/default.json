{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability permissions for PotatoClaw windows",
  "windows": [
    "dropbox",
    "hud",
    "snipper"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-exit",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}
